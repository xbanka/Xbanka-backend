AFFILIATE_FRONTEND_URL=
ERP_FRONTEND_URL=

ALLOW_SUPER_ADMIN_BOOTSTRAP=

ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR. JSON logs are used unless ENVIRONMENT is local/dev/development.
LOG_LEVEL=INFO
# Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRY=5

PAYSTACK_SECRET_KEY=
NUBAN_SECRET_KEY=

POSTGRES_USER=
POSTGRES_PASSWORD=
DB_HOST=
DB_PORT=
POSTGRES_DB=
DB_TYPE=

ALEMBIC_DATABASE_URL=

# Mail configurations
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=

S3_BUCKET_TRANSACTIONS=
S3_BUCKET_PAYOUTS=
# Private bucket for staff profile pictures. Leave unset and avatar uploads return 500.
S3_BUCKET_AVATARS=

AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

VERIFY_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=